  {
   "default": "0",
   "fieldname": "enable_outbound_tracking_url",
   "fieldtype": "Check",
   "label": "Push Tracking Link to Woo",
   "description": "When ON, every outbound order push also writes _jarz_tracking_url and _jarz_tracking_token to the WooCommerce order, and the store shows a 'Track your order' button. WooCommerce only stores the URL - all live tracking happens in the customer's browser against ERPNext. Requires Tracking Base URL below and Sales Invoice.custom_tracking_token (owned by jarz_pos)."
  },
  {
   "fieldname": "tracking_base_url",
   "fieldtype": "Data",
   "label": "Tracking Base URL",
   "description": "Public ERPNext tracking page, e.g. https://erp.orderjarz.com/track - the token is appended as a path segment. If the token belongs in the query string, use the {token} placeholder instead: https://erp.orderjarz.com/track?t={token}. Left blank, nothing is pushed and one Error Log is filed (a wrong link reaches customers by email and WhatsApp, so it is never guessed)."
  },
